# Jarvis Desktop Voice Assistant Configuration

# Audio synthesis: 'sapi' (recommended on Windows), 'pyttsx3' (fallback), or 'mock'
JARVIS_TTS_ENGINE=sapi

# Audio recognition: 'google' (default, free & fast), 'whisper', or 'mock'
JARVIS_STT_ENGINE=google

# Voice speed (words per minute) & volume (0.0 to 1.0)
JARVIS_VOICE_RATE=180
JARVIS_VOICE_VOLUME=1.0

# Wake Word (e.g. 'jarvis')
# Leave empty to respond to all speech without requiring a wake word
JARVIS_WAKE_WORD=

# Settling delay in seconds after speaking before opening microphone (prevents echo)
JARVIS_AUDIO_SETTLE_DELAY=0.25

# Microphone listening timeouts
JARVIS_LISTEN_TIMEOUT=6.0
JARVIS_PHRASE_TIME_LIMIT=10.0
